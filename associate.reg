Windows Registry Editor Version 5.00

; ============================================================
; 将 PictureViewer.exe 关联到常见图片格式（仅当前用户，无需管理员）。
; 使用前请把下面两处的 C:\\Path\\To\\PictureViewer.exe
; 替换为本机实际路径，注意反斜杠要写成双份。
; 也可以运行程序后按 Ctrl+A 自动完成关联。
; ============================================================

[HKEY_CURRENT_USER\Software\Classes\PictureViewer.Image.1]
@="Picture Viewer Image"

[HKEY_CURRENT_USER\Software\Classes\PictureViewer.Image.1\DefaultIcon]
@="\"C:\\Path\\To\\PictureViewer.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\PictureViewer.Image.1\shell\open]
"Icon"="\"C:\\Path\\To\\PictureViewer.exe\""

[HKEY_CURRENT_USER\Software\Classes\PictureViewer.Image.1\shell\open\command]
@="\"C:\\Path\\To\\PictureViewer.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.jpg]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.jpeg]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.jpe]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.png]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.bmp]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.gif]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.tif]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.tiff]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.webp]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.ico]
@="PictureViewer.Image.1"
"PerceivedType"="image"

[HKEY_CURRENT_USER\Software\Classes\.jxr]
@="PictureViewer.Image.1"
"PerceivedType"="image"
